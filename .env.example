NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Nunca use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Opcionais para classificar intencoes do Assistente IA. Sem essas chaves, o assistente usa regras locais.
# Valores aceitos em AI_PROVIDER: gemini, openrouter, groq.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_AGENT_MODEL=gemini-2.5-flash-lite
SOPHIA_MAX_TOOL_CALLS=4
SOPHIA_RULE_MIN_EVIDENCE=3
# Provider de planejamento cognitivo. Gemini continua sendo o padrao.
SOPHIA_MODEL_PROVIDER=gemini
SOPHIA_OPENAI_COMPATIBLE_BASE_URL=
SOPHIA_OPENAI_COMPATIBLE_API_KEY=
SOPHIA_OPENAI_COMPATIBLE_MODEL=
# Para usar Render, mantenha a URL pública; para desenvolvimento local, substitua por http://127.0.0.1:8030.
SOPHIA_DOCUMENT_WORKER_URL=https://geogestao-sophia-documents-worker.onrender.com
SOPHIA_DOCUMENT_WORKER_SECRET=
SOPHIA_DOCUMENT_STORAGE_BUCKET=documentos
SOPHIA_DOCUMENT_OCR_PROVIDER=tesseract
SOPHIA_DOCUMENT_OCR_LANGS=por+eng
SOPHIA_DOCUMENT_MAX_PAGES=150
SOPHIA_DOCUMENT_MAX_FILE_MB=50
SOPHIA_DOCUMENT_ENABLE_GEMINI=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google OAuth por usuario. Server-side only; nao prefixar com NEXT_PUBLIC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Protege endpoints de cron. Use header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Workers Python no Render Free. Server-side only; nunca use NEXT_PUBLIC_ para URLs ou segredos.
BUSCAGEO_WORKER_URL=https://geogestao-buscageo-worker.onrender.com
BUSCAGEO_WORKER_SECRET=
BUSCAGEO_STORAGE_BUCKET=documentos

# Desativado por padrao enquanto o controle de expediente estiver em revisao.
# Quando habilitado, o timer e o heartbeat sao renderizados no topo.
NEXT_PUBLIC_TIME_TRACKING_ENABLED=false

# Worker Python da ferramenta Análise Ambiental. Server-side only.
# Para usar Render, mantenha a URL pública; para desenvolvimento local, substitua por http://127.0.0.1:8020.
ANALISE_AMBIENTAL_WORKER_URL=https://geogestao-analise-ambiental-worker.onrender.com
ANALISE_AMBIENTAL_WORKER_SECRET=
ANALISE_AMBIENTAL_STORAGE_BUCKET=documentos
ANALISE_AMBIENTAL_PROVIDER=mapbiomas_gee
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=
GEE_SERVICE_ACCOUNT_JSON_BASE64=
MAPBIOMAS_10M_ASSET_ID=
MAPBIOMAS_RASTER_LOCAL_PATH=
MAPBIOMAS_RASTER_URL=
MAPBIOMAS_YEAR=2025
MAPBIOMAS_COLLECTION=coverage_10m
ANALISE_AMBIENTAL_HIDRO_PROVIDER=ana_bho6_gpkg
ANA_BHO6_TRECHO_DRENAGEM_URL=
ANA_BHO6_TRECHO_DRENAGEM_PATH=
ANA_BHO6_CURSO_DAGUA_URL=
ANA_BHO6_AREA_DRENAGEM_URL=
ANA_MASSAS_DAGUA_URL=
ANA_HIDRO_CACHE_DIR=./workers/analise-ambiental/data/ana
ANA_HIDRO_ENABLE_ARCGIS_FALLBACK=false

# Opcionais para importacao de bases geograficas. Drive e origem bruta, nao banco de consulta em tempo real.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Somente para scripts locais/admin de importacao geografica. Nunca use no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only para API oficial MapBiomas Alerta. Nunca use NEXT_PUBLIC_.
MAPBIOMAS_ALERT_API_URL=https://plataforma.alerta.mapbiomas.org/api/v2/graphql
MAPBIOMAS_ALERT_EMAIL=
MAPBIOMAS_ALERT_PASSWORD=
MAPBIOMAS_ALERT_TOKEN=

# Opcionais para Playwright E2E em banco Supabase de teste.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_RUN_MUTATION_TESTS=false

# Nunca use a service role key no frontend.
